# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.p12
*.pfx
*.jks
*.crt

# editor / IDE
.vscode/
.idea/

# caches / temporary and backup files
/.cache/
/.vite/
*.tmp
*.temp
*.bak
*.backup

# local databases and database dumps
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# workspace-local npm cache
/.npm-cache/
/.tmp/
/tmp/
*.tsbuildinfo

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
